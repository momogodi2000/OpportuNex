* text=auto
# Scripts executed inside Linux containers / Debian packages must keep LF endings.
*.sh text eol=lf
packaging/linux/** text eol=lf
Dockerfile* text eol=lf
# Schema and word lists are hashed / parsed byte-for-byte.
*.sql text eol=lf
engine/security/wordlists/*.txt text eol=lf
# Binary assets
*.png binary
*.ico binary
*.ttf binary
*.docx binary
*.opxbak binary
