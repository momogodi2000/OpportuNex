# Copy to .env and edit. Never commit the real .env.

# Public DNS name of this instance (Caddy requests the TLS certificate for it).
OPX_SYNC_DOMAIN=sync.example.org
OPX_SYNC_PUBLIC_URL=https://sync.example.org

# Database password (also used by the backup service).
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Accounts and quotas
OPX_SYNC_ALLOW_REGISTRATION=true
OPX_SYNC_QUOTA_MB=200
OPX_SYNC_SESSION_DAYS=30

# Outgoing e-mail (verification, password reset, invitations). Without SMTP the messages are
# written to the server log: acceptable for a personal instance only.
OPX_SYNC_SMTP_HOST=
OPX_SYNC_SMTP_PORT=587
OPX_SYNC_SMTP_USER=
OPX_SYNC_SMTP_PASSWORD=
OPX_SYNC_SMTP_FROM=Opportunex <no-reply@example.org>
OPX_SYNC_SMTP_STARTTLS=true
