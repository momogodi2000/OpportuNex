{$OPX_SYNC_DOMAIN} {
	encode gzip
	# TLS 1.3 only (ENF-SEC-11). Caddy obtains and renews the certificate automatically.
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# Metrics stay inside the Docker network.
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:8080
}
